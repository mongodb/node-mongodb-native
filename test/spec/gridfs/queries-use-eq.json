              "uploadDate": {
                "$date": "1970-01-01T00:00:00.000Z"
              },
              "filename": "file-2"
            }
          ]
        },
        {
          "collectionName": "fs.chunks",
          "databaseName": "gridfs-tests",
          "documents": [
            {
              "_id": {
                "$oid": "000000000000000000000011"
              },
              "files_id": {
                "$oid": "000000000000000000000001"
              },
              "n": 0,
              "data": {
                "$binary": {
                  "base64": "ESI=",
                  "subType": "00"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "description": "download with a file id containing a query operator does not return any files",
      "operations": [
        {
          "name": "download",
          "object": "bucket0",
          "arguments": {
            "id": {
              "$gt": {
                "$minKey": 1
              }
            }
          },
          "expectError": {
            "isClientError": true
          }
        }
      ]
    },
    {
      "description": "rename with a file id containing a query operator does not rename any files",
      "operations": [
        {
          "name": "rename",
          "object": "bucket0",
          "arguments": {
            "id": {
              "$gt": {
                "$minKey": 1
              }
            },
            "newFilename": "injected"
          },
          "expectError": {
            "isError": true
          }
        }
      ],
      "outcome": [
        {
          "collectionName": "fs.files",
          "databaseName": "gridfs-tests",
          "documents": [
            {
              "_id": {
                "$oid": "000000000000000000000001"
              },
              "length": 2,
              "chunkSize": 4,
              "uploadDate": {
                "$date": "1970-01-01T00:00:00.000Z"
              },
              "filename": "file-1"

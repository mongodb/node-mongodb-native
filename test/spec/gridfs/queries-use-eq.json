              "uploadDate": {
                "$date": "1970-01-01T00:00:00.000Z"
              },
              "filename": "file-2"
            }
          ]
        },
        {
          "collectionName": "fs.chunks",
          "databaseName": "gridfs-tests",
          "documents": [
            {
              "_id": {
                "$oid": "000000000000000000000011"
              },
              "files_id": {
                "$oid": "000000000000000000000001"
              },
              "n": 0,
              "data": {
                "$binary": {
                  "base64": "ESI=",
                  "subType": "00"
                }
              }
            }
          ]
        }
      ]
    }
